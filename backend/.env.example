# All optional. Without them the API runs on SQLite with mock models (fine for a demo).
# DATABASE_URL=postgresql+psycopg://user:pass@host/db   # e.g. Neon; data survives restarts
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# SIGNING_KEY_HEX=          # openssl rand -hex 32; keep it fixed so old Passports still verify
# JWT_SECRET=               # openssl rand -hex 32
# CORS_ORIGINS=http://localhost:3000,https://your-site.vercel.app
# SEED_ON_STARTUP=1         # loads the demo ledger facts and rules
